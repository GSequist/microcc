      "name": "Together AI",
      "api": "openai-chat",
      "requires": ["TOGETHER_API_KEY"],
      "base_url": "https://api.together.xyz/v1",
      "api_key_env": "TOGETHER_API_KEY",
      "free_text": true,
      "model_env": "TOGETHER_MODEL",
      "login": {
        "TOGETHER_API_KEY": "Paste TOGETHER_API_KEY (api.together.ai/settings/api-keys)",
        "TOGETHER_MODEL": "Model id, copy exactly from api.together.ai/models"
