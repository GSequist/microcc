{
  "schema": 2,
  "default_model": "sonnet-5.5",
  "routing": ["ollama", "claude-code", "anthropic", "foundry", "litellm", "openrouter", "openai", "bedrock", "vertex", "azure", "groq", "deepseek", "xai", "together", "fireworks"],
  "login_optional": {
    "SERPAPI_KEY": "SERPAPI_KEY — optional, Enter to skip"
  },
  "providers": {
    "anthropic": {
      "name": "Anthropic",
      "api": "anthropic-messages",
      "requires": ["ANTHROPIC_API_KEY"],
      "api_key_env": "ANTHROPIC_API_KEY",
      "login": {
        "ANTHROPIC_API_KEY": "Paste ANTHROPIC_API_KEY (sk-ant-...)"
      },
      "first_event_timeout": 120,
      "compat": {
        "betas": true
      }
    },
    "claude-code": {
      "name": "Claude Code",
      "api": "anthropic-messages",
      "requires": ["ANTHROPIC_OAUTH_TOKEN"],
      "api_key_env": "ANTHROPIC_OAUTH_TOKEN",
      "auth": "oauth",
      "ids_from": "anthropic",
      "first_event_timeout": 120,
      "compat": {
        "betas": true
      }
    },
    "bedrock": {
      "name": "Amazon Bedrock",
      "api": "anthropic-messages",
      "client": "bedrock",
      "requires": ["AWS_BEARER_TOKEN_BEDROCK"],
      "api_key_env": "AWS_BEARER_TOKEN_BEDROCK",
      "region_env": "AWS_REGION",
      "region": "us-east-1",
      "login": {
        "AWS_BEARER_TOKEN_BEDROCK": "Paste a Bedrock API key (AWS console → Amazon Bedrock → API keys)",
        "AWS_REGION": "AWS region with Claude enabled.\nEnter for default: us-east-1"
      },
      "first_event_timeout": 120
    },
    "vertex": {
      "name": "Google Vertex AI",
      "api": "anthropic-messages",
      "client": "vertex",
      "requires": ["ANTHROPIC_VERTEX_PROJECT_ID"],
      "project_env": "ANTHROPIC_VERTEX_PROJECT_ID",
      "region_env": "CLOUD_ML_REGION",
      "region": "global",
      "package": {
        "import": "google.auth",
        "pip": "google-auth[requests]>=2,<3"
      },
      "login": {
        "ANTHROPIC_VERTEX_PROJECT_ID": "GCP project id with Claude enabled in Vertex AI Model Garden.\nAuth uses your gcloud login: run `gcloud auth application-default login` first",
        "CLOUD_ML_REGION": "Vertex region.\nEnter for default: global"
      },
      "first_event_timeout": 120
    },
    "foundry": {
      "name": "Foundry",
      "api": "anthropic-messages",
      "requires": ["FOUNDRY_BASE_URL", "FOUNDRY_API_KEY"],
      "base_url_env": "FOUNDRY_BASE_URL",
      "api_key_env": "FOUNDRY_API_KEY",
      "login": {
        "FOUNDRY_BASE_URL": "Paste your Foundry endpoint base URL",
        "FOUNDRY_API_KEY": "Paste your FOUNDRY_API_KEY"
      },
      "first_event_timeout": 120
    },
    "litellm": {
      "name": "LiteLLM",
      "api": "openai-chat",
      "requires": ["LITELLM_BASE_URL", "LITELLM_API_KEY"],
      "base_url_env": "LITELLM_BASE_URL",
      "api_key_env": "LITELLM_API_KEY",
      "login": {
        "LITELLM_BASE_URL": "Paste your LiteLLM proxy base URL",
        "LITELLM_API_KEY": "Paste your LITELLM_API_KEY"
      },
      "first_event_timeout": 300,
      "compat": {
        "reasoning": "litellm",
        "cache_control": true,
        "betas": true
      }
    },
    "openai": {
      "name": "OpenAI",
      "api": "openai-responses",
      "requires": ["OPENAI_API_KEY"],
      "base_url_env": "OPENAI_BASE_URL",
      "api_key_env": "OPENAI_API_KEY",
      "login": {
        "OPENAI_API_KEY": "Paste OPENAI_API_KEY (chat backend)"
      },
      "first_event_timeout": 120,
      "compat": {
        "replay_reasoning": true,
        "explicit_cache": true
      }
    },
    "azure": {
      "name": "Azure OpenAI",
      "api": "openai-responses",
      "requires": ["AZURE_OPENAI_BASE_URL", "AZURE_OPENAI_API_KEY"],
      "base_url_env": "AZURE_OPENAI_BASE_URL",
      "api_key_env": "AZURE_OPENAI_API_KEY",
      "free_text": true,
      "model_env": "AZURE_OPENAI_DEPLOYMENT",
      "login": {
        "AZURE_OPENAI_BASE_URL": "Azure OpenAI v1 endpoint, e.g.\n  https://YOUR-RESOURCE.openai.azure.com/openai/v1/",
        "AZURE_OPENAI_API_KEY": "Paste your AZURE_OPENAI_API_KEY",
        "AZURE_OPENAI_DEPLOYMENT": "Deployment name of a reasoning model (gpt-5 family or newer)"
      },
      "first_event_timeout": 180
    },
    "openrouter": {
      "name": "OpenRouter",
      "api": "openai-chat",
      "requires": ["OPENROUTER_API_KEY"],
      "base_url_env": "OPENROUTER_BASE_URL",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "free_text": true,
      "model_env": "OPENROUTER_MODEL",
      "login": {
        "OPENROUTER_API_KEY": "Paste OPENROUTER_API_KEY (openrouter.ai/keys)",
        "OPENROUTER_MODEL": "Model slug, author/name — copy exactly from openrouter.ai/models\ne.g. qwen/qwen3-235b-a22b-thinking-2507, deepseek/deepseek-chat,\n  z-ai/glm-4.6, moonshotai/kimi-k2"
      },
      "first_event_timeout": 180,
      "compat": {
        "reasoning": "openrouter"
      }
    },
    "groq": {
      "name": "Groq",
      "api": "openai-chat",
      "requires": ["GROQ_API_KEY"],
      "base_url": "https://api.groq.com/openai/v1",
      "api_key_env": "GROQ_API_KEY",
      "free_text": true,
      "model_env": "GROQ_MODEL",
      "login": {
        "GROQ_API_KEY": "Paste GROQ_API_KEY (console.groq.com/keys)",
        "GROQ_MODEL": "Model id, copy exactly from console.groq.com/docs/models"
      },
      "first_event_timeout": 120,
      "compat": {
        "reasoning": "read",
        "omit_max_tokens": true
      }
    },
    "deepseek": {
      "name": "DeepSeek",
      "api": "openai-chat",
      "requires": ["DEEPSEEK_API_KEY"],
      "base_url": "https://api.deepseek.com",
      "api_key_env": "DEEPSEEK_API_KEY",
      "free_text": true,
      "model_env": "DEEPSEEK_MODEL",
      "login": {
        "DEEPSEEK_API_KEY": "Paste DEEPSEEK_API_KEY (platform.deepseek.com/api_keys)",
        "DEEPSEEK_MODEL": "Model id, e.g. deepseek-chat or deepseek-reasoner (api-docs.deepseek.com)"
      },
      "first_event_timeout": 180,
      "compat": {
        "reasoning": "read",
        "omit_max_tokens": true
      }
    },
    "xai": {
      "name": "xAI",
