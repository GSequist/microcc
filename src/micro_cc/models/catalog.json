      "login": {
        "XAI_API_KEY": "Paste XAI_API_KEY (console.x.ai)",
        "XAI_MODEL": "Model id, copy exactly from docs.x.ai/docs/models"
      },
      "first_event_timeout": 180,
      "compat": {
        "reasoning": "read",
        "omit_max_tokens": true
      }
    },
